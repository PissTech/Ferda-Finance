<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>OSINT Dashboard</title>

<style>
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    background: #0b0f14;
    color: #e5e7eb;
  }

  header {
    padding: 12px 20px;
    background: #111827;
    border-bottom: 1px solid #1f2937;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  h1 {
    font-size: 18px;
    margin: 0;
    color: #60a5fa;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 2fr 2fr;
    height: calc(100vh - 50px);
  }

  .panel {
    border-right: 1px solid #1f2937;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .panel h2 {
    font-size: 14px;
    padding: 10px;
    background: #111827;
    margin: 0;
    border-bottom: 1px solid #1f2937;
  }

  iframe {
    flex: 1;
    width: 100%;
    border: none;
    background: #000;
  }

  .news {
    overflow-y: auto;
    padding: 10px;
  }

  .news-item {
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid #1f2937;
  }

  .news-item a {
    color: #93c5fd;
    text-decoration: none;
    font-size: 13px;
  }

  .news-item span {
    display: block;
    font-size: 11px;
    color: #6b7280;
  }

  .controls {
    display: flex;
    gap: 10px;
  }

  button {
    background: #1f2937;
    color: white;
    border: none;
    padding: 6px 10px;
    cursor: pointer;
  }

  button:hover {
    background: #374151;
  }
</style>
</head>

<body>

<header>
  <h1>🧠 OSINT Live Dashboard</h1>
  <div class="controls">
    <button onclick="loadNews()">Refresh News</button>
  </div>
</header>

<div class="grid">

  <!-- NEWS PANEL -->
  <div class="panel">
    <h2>🌍 Global News Feed</h2>
    <div class="news" id="news"></div>
  </div>

  <!-- SHIP TRACKING -->
  <div class="panel">
    <h2>🚢 Ship Tracking (AIS)</h2>
    <iframe src="https://www.marinetraffic.com/en/ais/home/centerx:0/centery:20/zoom:2"></iframe>
  </div>

  <!-- AIRCRAFT TRACKING -->
  <div class="panel">
    <h2>✈️ Aircraft Tracking (ADS-B)</h2>
    <iframe src="https://globe.adsbexchange.com/"></iframe>
  </div>

</div>

<script>
const feeds = [
  "https://rss.nytimes.com/services/xml/rss/nyt/World.xml",
  "https://feeds.bbci.co.uk/news/world/rss.xml",
  "https://www.aljazeera.com/xml/rss/all.xml",
  "https://rss.dw.com/xml/rss-en-world"
];

async function loadNews() {
  const container = document.getElementById("news");
  container.innerHTML = "Loading...";

  let allItems = [];

  for (const url of feeds) {
    try {
      const res = await fetch("https://api.allorigins.win/get?url=" + encodeURIComponent(url));
      const data = await res.json();

      const parser = new DOMParser();
      const xml = parser.parseFromString(data.contents, "text/xml");

      const items = xml.querySelectorAll("item");

      items.forEach(item => {
        allItems.push({
          title: item.querySelector("title").textContent,
          link: item.querySelector("link").textContent,
          source: url
        });
      });

    } catch (e) {
      console.log("Feed error:", url);
    }
  }

  container.innerHTML = "";

  allItems.slice(0, 50).forEach(item => {
    const div = document.createElement("div");
    div.className = "news-item";
    div.innerHTML = `
      <a href="${item.link}" target="_blank">${item.title}</a>
      <span>${item.source}</span>
    `;
    container.appendChild(div);
  });
}

loadNews();
</script>

</body>
</html>